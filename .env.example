# Docker Swarm placement. For a single-node deployment, use the same hostname.
DOCAGENT_MANAGER_HOST=
DOCAGENT_NODE1_HOST=

MYSQL_DATABASE=docagent
MYSQL_USERNAME=docagent
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

REDIS_PASSWORD=

# JWT signing secret: use a unique value of at least 32 UTF-8 bytes.
JWT_SECRET=

RABBITMQ_USERNAME=docagent
RABBITMQ_PASSWORD=

MINIO_BUCKET=docagent
# Optional: override permissions; otherwise they follow MINIO_BUCKET.
# MINIO_BUCKET_PERMISSIONS=document=admin,user;documents=admin,user;docagent=admin,user
MINIO_ACCESS_KEY=docagentadmin
MINIO_SECRET_KEY=

# 协同端口浏览器要连所以是暴露的，而它的 /ai/* 能改任何调用者有读权限的文档。
# docagent 和 collab-server 两侧必须一致，不设置则 agent 读写文档一律 403。
COLLAB_AI_SECRET=

# 百炼托管的 deepseek-v4-pro 对话。
DASHSCOPE_API_KEY=

# OpenAI 直连，只给 gpt-5.5 用。base-url 结尾不要带 /v1。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# Frontend development proxy.
VITE_API_TARGET=http://localhost:8080
