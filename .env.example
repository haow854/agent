# 复制为仓库根目录的 .env 后填写。本地开发和 docker compose 部署共用这一套键名。

MYSQL_DATABASE=docagent
MYSQL_USERNAME=docagent
MYSQL_PASSWORD=
# 只在 docker compose 部署时使用，用于初始化 MySQL 容器
MYSQL_ROOT_PASSWORD=

REDIS_PASSWORD=

# JWT signing secret: use a unique value of at least 32 UTF-8 bytes.
JWT_SECRET=

RABBITMQ_USERNAME=docagent
RABBITMQ_PASSWORD=

MINIO_BUCKET=docagent
# Optional: override permissions; otherwise they follow MINIO_BUCKET.
# MINIO_BUCKET_PERMISSIONS=document=admin,user;documents=admin,user;docagent=admin,user
MINIO_ACCESS_KEY=docagentadmin
MINIO_SECRET_KEY=

# 协同服务的 /ai/* 能改任何调用者有读权限的文档，只允许持有这个密钥的后端调用。
# docagent 和 collab-server 两侧必须一致，不设置则 agent 读写文档一律 403。
COLLAB_AI_SECRET=

# 百炼托管的 DeepSeek 对话。
DASHSCOPE_API_KEY=
# 发给百炼的模型名，不填时是 deepseek-v4.1-flash-1017
# DASHSCOPE_CHAT_MODEL=deepseek-v4.1-flash-1017

# 联网搜索（Agent 的 web_search）和网页读取（web_fetch）走同一个 MCP 服务，不配置时 Agent 无法联网。
# 网页读取调的是 Tavily 的 tavily_extract，换成别的搜索服务后只剩搜索能用。
# Tavily 托管（免费 1000 次/月），key 在 tavily.com 注册后获取：
# SEARCH_MCP_STREAMABLE_URL=https://mcp.tavily.com/mcp/?tavilyApiKey=<你的 key>
# SEARCH_MCP_TOOL_NAME=tavily_search
# SEARCH_MCP_TOPK_PARAM=max_results

# OpenAI 直连，只给 gpt-5.5 用。base-url 结尾不要带 /v1。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# Frontend development proxy.
VITE_API_TARGET=http://localhost:8080

# ---- docker compose 部署（deploy/docker-compose.yml）----
# 服务器公网 IP，certbot 用它申请 Let's Encrypt 的 IP 证书；本地不设，不设时只走 HTTP
# PUBLIC_IP=
# 对外端口，默认 80 和 443。Let's Encrypt 验证要求公网的 80 端口能访问
# HTTP_PORT=80
# HTTPS_PORT=443
# 是否开放注册：docker compose 部署默认关闭，后端直接拒绝；本地开发默认开放（评测脚本要注册账号）
# REGISTRATION_ENABLED=false
# 在国内服务器上构建 collab-server 镜像时使用的 npm 源
# NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm/
